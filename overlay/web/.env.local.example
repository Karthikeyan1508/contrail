# Where the Contrail API is running. The Next rewrite proxies /api/* to it,
# which keeps the browser same-origin and sidesteps CORS entirely.
API_URL=http://localhost:4000

# Leave unset to use the proxy above. Set only if you want the browser to call
# the API directly (then the API's WEB_ORIGIN must allow this origin).
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
