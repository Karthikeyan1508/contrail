# ---------------------------------------------------------------------------
# Contrail API  —  every key below is OPTIONAL.
# With no keys at all the system runs fully on fixtures and deterministic
# generation. The UI shows exactly which mode each subsystem is in.
# ---------------------------------------------------------------------------

PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Flight status source --------------------------------------------------
# auto = AviationStack if keyed, else Amadeus if keyed, else the offline fixture.
FLIGHT_PROVIDER=auto

# --- AviationStack ---------------------------------------------------------
# https://aviationstack.com  ->  free tier is enough.
# The free plan rejects the flight_date parameter, so the query is for the
# current day. Live schedule, terminal and gate are merged in; the demo's
# cancellation and re-accommodation inventory stay local.
AVIATIONSTACK_ACCESS_KEY=
AVIATIONSTACK_HOST=https://api.aviationstack.com

# --- Amadeus for Developers ------------------------------------------------
# The self-service portal was decommissioned on 17 July 2026 and its keys
# deactivated. Kept for an Enterprise endpoint: set AMADEUS_HOST and creds.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOST=https://test.api.amadeus.com

# The flight the demo resolves live. Must operate on DEMO_FLIGHT_DATE.
DEMO_CARRIER_CODE=6E
DEMO_FLIGHT_NUMBER=860
DEMO_FLIGHT_DATE=2026-09-05

# --- Contentstack ----------------------------------------------------------
# Leave CONTENTSTACK_MODE=local to use the on-disk variant store.
# Set to "live" once the stack, content type and tokens exist.
CONTENTSTACK_MODE=local
CONTENTSTACK_API_KEY=
CONTENTSTACK_DELIVERY_TOKEN=
CONTENTSTACK_MANAGEMENT_TOKEN=
CONTENTSTACK_ENVIRONMENT=production
CONTENTSTACK_LOCALE=en
CONTENTSTACK_REGION=na
CONTENTSTACK_CONTENT_TYPE=disruption_message

# --- LLM (optional) --------------------------------------------------------
# Without a key the drafter uses the deterministic template library, which is
# what you want for a repeatable stage demo anyway.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
